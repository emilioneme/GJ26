  - 'watcher: "Grrrrrrrrrsefseffrr"'
  - 'watcher: "AWDJhbJHAWDB aKWDBA BWD  aWDNm"'
  - 'watcher: "YObdAWDuAWD AWAADWMOTHER AWFUkEHRT"'
  npcLayer:
    serializedVersion: 2
    m_Bits: 4195328
  npcDialogues:
  - 'inmate: "blend in, blend in... blend in..."'
  - 'inmate: "dont blow my cover! "'
  - 'inmate: "all we have to do is act like a sheep"'
  - 'inmate: "you are gonna get us in trouble if you dont blend in"'
  - 'inmate: "be like evryone else"'
  - 'inmate: "we are always being watched"'
  - 'inmate: "they are watching us"'
  - 'inmate: "blend in"'
