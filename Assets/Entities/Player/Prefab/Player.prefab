    serializedVersion: 2
    m_Bits: 2097152
  alarmTriggeredInnerDialogues:
  - 'you: i broke it, they will be watching me, I need to blend in'
  alarmInnerDialogues:
  - another light I cannot stand - Press E To Break It
  - if i break this will i be in trouble  - Press E To Break It
  - if i break thsi will it distract the guards?  - Press E To Break It
  helper1Layer:
    serializedVersion: 2
    m_Bits: 8388608
  Helper1HintDialogues:
  - 'inmate: "once you get the hang of blending in, you can get away with things
    that distract the watchers"'
  Helper1AlertDialogues:
  - 'inmate: "you have distracted the watchers, itsd your chance to go up, but make
    sure to not call too mcuh atention" '
  ladderLayer:
    serializedVersion: 2
    m_Bits: 1048576
  ladderLockedInnerDialogue:
  - 'you: i cannot climb this while the guards are here, either I distract them or
    I continou to blend in'
  ladderUnlockedInnerDialogue:
  - 'you: i might never get another opportunity - Press E to Climb'
  - 'you: while I am not being watchedb I might aswell - Press E to Climb'
  helper2Layer:
    serializedVersion: 2
    m_Bits: 16777216
  helper2ValuableDialogue:
  - "inmate: \"we need to get more weapons and talk to our leader\"\t"
  - 'inmate: "another one like us? you need to talk to our leader"'
  - 'inmate: "talk to our leader, they want to talk to you"'
  helper2RioterDialogue:
  - 'inmate: "great, you have a weapon, now give it to our leader"'
  - 'inmate: "talk to a leader, and give them the weapon"-'
  valuableLayer:
    serializedVersion: 2
    m_Bits: 268435456
  valuableDialogue:
  - 'you: should i take it? i might get caught - Press E to Take'
  - 'you: this can be used to turn off the light - Press E to Take'
  hasValuableDialogue:
  - 'you: I already have a weapon'
  valuableCollectedDialogue:
  - 'you: i need to keep this weapon hidden, maybe I can use it to break the light'
  rioterLayer:
    serializedVersion: 2
    m_Bits: 33554432
  rioterDialogue:
  - 'rioter: "show me you have a weapon and BREAK the light across the bridge" -
