  guardLayer:
    serializedVersion: 2
    m_Bits: 524288
  guardDialogues:
  - '"Grrrrrrrrrsefseffrr"'
  - '"AWDJhbJHAWDB aKWDBA BWD  aWDNm"'
  - '"YObdAWDuAWD AWAADWMOTHER AWFUkEHRT"'
  npcLayer:
    serializedVersion: 2
    m_Bits: 4195328
  npcDialogues:
  - '"blend in, blend in... blend in..."'
  - '"turn off the light, turn off the ligh!"'
  - '"my brain!!"'
  - '"dont blow my cover! "'
  - '"all we have to do is act like a sheep"'
  - '"you are gonna get us in trouble"'
  - '"be like evryone else"'
  - '"........"'
  - i should do what they dp
  alarmLayer:
    serializedVersion: 2
    m_Bits: 2097152
  alarmTriggeredInnerDialogues:
  - fuck! i gotta blend in!
  - im calling to much attention, i need to go
  alarmInnerDialogues:
  - another light I cannot stand - Press E To Break It
  - if i break this will i be in trouble  - Press E To Break It
  - if i break thsi will it distract the guards?  - Press E To Break It
  helper1Layer:
    serializedVersion: 2
    m_Bits: 8388608
  Helper1HintDialogues:
  - '"there must be a way up"'
  - '"maybe i can distract the guards while you go up"'
  - '"some one needs to turn off the lights"'
  Helper1AlertDialogues:
  - '"go go go! leave, before they get you!" '
  ladderLayer:
    serializedVersion: 2
    m_Bits: 1048576
  ladderLockedInnerDialogue:
  - i cannot climb this while the guards are here
  ladderUnlockedInnerDialogue:
  - i might never get another opportunity - Press E to Climb
  - while the guards are distracted I might aswell - Press E to Climb
  helper2Layer:
    serializedVersion: 2
    m_Bits: 16777216
  helper2ValuableDialogue:
  - '"we need to get more weapons and talk to our leader"'
  - '"another one like us? we are different. you need to talk to our leader"'
  - '"talk to our leader, they want to talk to you"'
  helper2RioterDialogue:
  - '"great, you have a weapon, now give it to our leader"-'
  - '"talk to a leader, and give them the weapon"-'
  valuableLayer:
    serializedVersion: 2
    m_Bits: 268435456
  valuableDialogue:
  - should i take it? i might get caught - Press E to Take
  - this can be used to turn off the light - Press E to Take
  hasValuableDialogue: []
  valuableCollectedDialogue:
  - i need to keep this weapon hidden, maybe I can use it to break the light
  rioterLayer:
    serializedVersion: 2
    m_Bits: 33554432
  rioterDialogue:
  - 'show me you have a weapon and BREAK the light across the bridge - Press E to
    Show '
  rioterChantDialogue:
  - RIASE YOU WEAPONS! IT IS TIME TO TURN OFF THE LIGHT!!
  bridgeLayer:
    serializedVersion: 2
    m_Bits: 67108864
  bridgeLockedDialogues:
  - it is too risky right now
  - gotta wait for the perfect moment to turn off the light
  - with guards here I cannot cross this
